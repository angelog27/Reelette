rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Catalog (public read, no client writes) ───────────────────
    match /catalog/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ── Posts (public read; create/delete require auth) ───────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
      allow update: if false; // mutations go through backend only

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.user_id == request.auth.uid;
        allow delete: if request.auth != null
                      && resource.data.user_id == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Public profile fields are readable by anyone
      allow read: if true;

      // Only the account owner can write their own document
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollections — only the owner can read/write
      match /{subcollection}/{docId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Groups ────────────────────────────────────────────────────
    match /groups/{groupId} {
      // Members can read; writes go through the backend which enforces membership
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow write: if false; // backend-only

      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow write: if false; // backend-only
      }
    }

    // ── Conversations ─────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow write: if false; // backend-only

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if false; // backend-only
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
